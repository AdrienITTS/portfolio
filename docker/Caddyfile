# Internal Caddy: plain HTTP on :80. TLS is handled by the front Caddy on the VPS.
:80 {
	root * /srv
	encode zstd gzip

	# Nuxt build assets have a content hash in their name: cache them for a year.
	@assets path /_nuxt/* /fonts/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# HTML must always be revalidated, or visitors keep an old version after a deploy.
	@html path / /en /*.html
	header @html Cache-Control "no-cache"

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
	}

	# Every page is pre-rendered: /en is served from /en/index.html.
	try_files {path} {path}/index.html {path}.html
	file_server

	handle_errors 404 {
		rewrite * /404.html
		file_server
	}
}
